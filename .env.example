# ==============================================================================
# TRIP BY GENIE CRM CONFIGURATION
# ==============================================================================

PORT=5000
APP_URL=http://localhost:3000

# ==============================================================================
# SMTP REAL EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Option 1: Gmail (Recommended for quick testing)
# Step 1: In your Google Account, enable 2-Step Verification
# Step 2: Create an App Password at: https://myaccount.google.com/apppasswords
# Step 3: Fill in your Gmail and 16-character App Password below:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 2: Custom SMTP Server (Brevo / SendGrid / AWS SES / Mailgun / Hostinger)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# SMTP_FROM="Trip by Genie" <no-reply@tripbygenie.in>
